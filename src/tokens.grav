// tokens.grav — personal access tokens: an Orbit model (only a hash of the
// secret is stored), its migration, and where tokens are kept (the app's
// database through Orbit, or memory for tests).
import "std"
import "grav-orbit"
use orbit.*

namespace apogee {

    // A token, as a row of personal_access_tokens.
    class PersonalAccessToken extends Model {
        public id: long = 0
        // The owner: its class name and id ("app.User", "42").
        public ownerType: string = ""
        public ownerId: string = ""
        public name: string = ""
        public tokenHash: string = ""
        // What the token may do, comma-separated ("*": anything).
        public abilities: string = "*"
        // Unix seconds (0: never used / never expires).
        public lastUsedAt: long = 0
        public expiresAt: long = 0
        public issuedAt: long = 0
        constructor() {}
        // (a check scans the text: no list is made for it)
        fn can(ability: string) -> bool {
            if (self.abilities == "*") { return true; }
            return Str.contains("," + self.abilities + ",", "," + ability + ",") || Str.contains("," + self.abilities + ",", ",*,");
        }
        fn cant(ability: string) -> bool { return !self.can(ability); }
        fn abilityList() -> Array<string> { return Str.split(self.abilities, ","); }
        fn expired(now: long) -> bool { return self.expiresAt > 0 && now >= self.expiresAt; }
        // The token as shown to its owner (no hash).
        fn summary() -> JsonValue {
            let o = Json.object();
            o.set("id", self.id);
            o.set("name", self.name);
            let a = Json.array();
            for (x in self.abilityList()) { a.push(x); }
            o.set("abilities", a);
            o.set("last_used_at", self.lastUsedAt);
            o.set("expires_at", self.expiresAt);
            o.set("issued_at", self.issuedAt);
            return o;
        }
    }

    class CreatePersonalAccessTokensTable extends Migration {
        constructor() {}
        fn up() {
            Schema.create("personal_access_tokens", fn(t: Blueprint) {
                t.id();
                t.varchar("owner_type", 190);
                t.varchar("owner_id", 64);
                t.varchar("name");
                t.varchar("token_hash", 64);
                t.text("abilities");
                t.bigInteger("last_used_at").defaultValue(0);
                t.bigInteger("expires_at").defaultValue(0);
                t.bigInteger("issued_at").defaultValue(0);
                t.index(["owner_type", "owner_id"]);
            });
        }
        fn down() { Schema.dropIfExists("personal_access_tokens"); }
    }

    interface AccessTokenStore {
        // Saves a new token and sets its id.
        fn insert(t: PersonalAccessToken)
        fn find(id: long) -> PersonalAccessToken
        fn ofOwner(ownerType: string, ownerId: string) -> Array<PersonalAccessToken>
        fn touch(id: long, at: long)
        fn delete(id: long) -> bool
        fn deleteOfOwner(ownerType: string, ownerId: string) -> long
        // Removes tokens that expired before `before` (unix seconds); how many.
        fn pruneExpired(before: long) -> long
    }

    // In the app's database, through Orbit (personal_access_tokens; see the migration).
    class OrbitAccessTokenStore implements AccessTokenStore {
        constructor() {}
        private fn q() -> Query<PersonalAccessToken> { return new Query<PersonalAccessToken>(TableMap.of(reflect(PersonalAccessToken))); }
        fn insert(t: PersonalAccessToken) { t.save(); }
        fn find(id: long) -> PersonalAccessToken { return self.q().firstWhere("id", id); }
        fn ofOwner(ownerType: string, ownerId: string) -> Array<PersonalAccessToken> {
            return self.q().where("owner_type", ownerType).where("owner_id", ownerId).orderBy("id").get();
        }
        fn touch(id: long, at: long) { self.q().where("id", id).update({"last_used_at": at}); }
        fn delete(id: long) -> bool { return self.q().where("id", id).delete() > 0; }
        fn deleteOfOwner(ownerType: string, ownerId: string) -> long { return self.q().where("owner_type", ownerType).where("owner_id", ownerId).delete(); }
        fn pruneExpired(before: long) -> long { return self.q().where("expires_at", ">", 0).where("expires_at", "<", before).delete(); }
    }

    // In this process's memory (development, tests). Thread-safe.
    class MemoryAccessTokenStore implements AccessTokenStore {
        private rows: HashMap<long, PersonalAccessToken> = new HashMap<long, PersonalAccessToken>()
        private next: long = 1
        private lock: Mutex = new Mutex()
        constructor() {}
        fn insert(t: PersonalAccessToken) { self.lock.lock(); t.id = self.next; self.next += 1; self.rows.put(t.id, t); self.lock.unlock(); }
        fn find(id: long) -> PersonalAccessToken { self.lock.lock(); let t = self.rows.getOr(id, null); self.lock.unlock(); return t; }
        fn ofOwner(ownerType: string, ownerId: string) -> Array<PersonalAccessToken> {
            let out = new Array<PersonalAccessToken>();
            self.lock.lock();
            for ((_, t) in self.rows) { if (t.ownerType == ownerType && t.ownerId == ownerId) { out.push(t); } }
            self.lock.unlock();
            out.sortBy(fn(a: PersonalAccessToken, b: PersonalAccessToken) -> int { return a.id < b.id ? -1 : 1; });
            return out;
        }
        fn touch(id: long, at: long) { self.lock.lock(); let t = self.rows.getOr(id, null); if (t != null) { t.lastUsedAt = at; } self.lock.unlock(); }
        fn delete(id: long) -> bool { self.lock.lock(); let had = self.rows.containsKey(id); self.rows.remove(id); self.lock.unlock(); return had; }
        fn deleteOfOwner(ownerType: string, ownerId: string) -> long {
            let n: long = 0;
            self.lock.lock();
            for (k in self.rows.keys()) { let t = self.rows.get(k); if (t.ownerType == ownerType && t.ownerId == ownerId) { self.rows.remove(k); n += 1; } }
            self.lock.unlock();
            return n;
        }
        fn pruneExpired(before: long) -> long {
            let n: long = 0;
            self.lock.lock();
            for (k in self.rows.keys()) { let t = self.rows.get(k); if (t.expiresAt > 0 && t.expiresAt < before) { self.rows.remove(k); n += 1; } }
            self.lock.unlock();
            return n;
        }
    }
}
